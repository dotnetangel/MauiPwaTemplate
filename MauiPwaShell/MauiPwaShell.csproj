<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target Android only on Linux, all platforms on other OS -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Linux'))">net8.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Linux'))">net8.0-android;net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MauiPwaShell</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>MauiPwaShell</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.example.mauipwashell</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Platform versions -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#512BD4" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="Plugin.Firebase" Version="3.1.0" />
  </ItemGroup>

  <!-- Android -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net8.0-android'))">
    <GoogleServicesJson Include="Platforms\Android\google-services.json" />
  </ItemGroup>

  <!-- iOS -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net8.0-ios'))">
    <BundleResource Include="Platforms\iOS\GoogleService-Info.plist" />
  </ItemGroup>

  <!-- Native Library Integration using LibraryImport/DllImport -->
  
  <!-- Android: Compile and package native C library -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net8.0-android'))">
    <!-- Native library sources -->
    <None Include="NativeBindings\examplesdk.h" />
    <None Include="NativeBindings\examplesdk.c" />
    <None Include="NativeBindings\build-android.sh" />
    
    <!-- Pre-built native libraries for Android (if available) -->
    <!-- Build the native library using build-android.sh before building the MAUI app -->
    <!-- Uncomment these lines after building the native library:
    <AndroidNativeLibrary Include="Platforms\Android\libs\arm64-v8a\libexamplesdk.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="Platforms\Android\libs\armeabi-v7a\libexamplesdk.so">
      <Abi>armeabi-v7a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="Platforms\Android\libs\x86\libexamplesdk.so">
      <Abi>x86</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="Platforms\Android\libs\x86_64\libexamplesdk.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>
    -->
  </ItemGroup>

  <!-- iOS: Link native C library -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net8.0-ios'))">
    <!-- Native library sources -->
    <None Include="NativeBindings\examplesdk.h" />
    <None Include="NativeBindings\examplesdk.c" />
    <None Include="NativeBindings\build-ios.sh" />
    
    <!-- Compile the C source directly into the app -->
    <Compile Include="NativeBindings\examplesdk.c">
      <CompileAs>C</CompileAs>
    </Compile>
    
    <!-- Alternative: Link pre-built static library (uncomment if using pre-built libs)
    <NativeReference Include="Platforms\iOS\libs\libexamplesdk-arm64.dylib">
      <Kind>Dynamic</Kind>
      <SmartLink>False</SmartLink>
      <ForceLoad>True</ForceLoad>
    </NativeReference>
    -->
  </ItemGroup>

</Project>
